# Example env skeleton. Copy to .env and fill in real values.
# cp .env.example .env

# OpenWeatherMap API key (required for live weather calls)
OPENWEATHER_API_KEY=

# Redis password (required for Compose; never commit the real value)
REDIS_PASSWORD=change-me

# Redis connection (mood storage). Include the password after redis://:
REDIS_URL=redis://:change-me@localhost:6379/0

# Flask bind (container needs 0.0.0.0)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Number of reverse proxies that set X-Forwarded-* (0 = off).
# Set to 1 when api sits behind nginx/ALB. Wrong value is a security issue.
PROXY_COUNT=0
