# Example env skeleton. Copy to .env and fill in real values.
# cp .env.example .env

# OpenWeatherMap API key (required for live weather calls)
OPENWEATHER_API_KEY=

# Redis connection (mood storage)
REDIS_URL=redis://localhost:6379/0

# Flask bind (container needs 0.0.0.0)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
